# ─── API Keys ────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX=doc-chatbot
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
TAVILY_API_KEY=your-tavily-api-key-here

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123

# ─── Database ────────────────────────────────────────────
DATABASE_URL=sqlite:///./storage/app.db

# ─── Upload limits ───────────────────────────────────────
UPLOAD_MAX_MB=25

# ─── LLM defaults ───────────────────────────────────────
# Free tier = ~20 requests per model per day; fallbacks (comma-separated) are tried in order
# when a model is retired (404) or out of quota (429).
LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite
LLM_MAX_RETRIES=3
# Real AI requests one chat message may use (retries included); stops runaway runs on the free tier.
LLM_MAX_CALLS_PER_RUN=30
# Hidden reasoning tokens per call on Gemini 2.5+ models; small = much faster planning/writing. -1 = model default.
LLM_THINKING_BUDGET=512

# ─── Logging ────────────────────────────────────────────
LOG_LEVEL=INFO
# text | json (one JSON object per line, with run_id)
LOG_FORMAT=text

# ─── Research & photos ──────────────────────────────────
# Scholarly sources (OpenAlex, arXiv, Semantic Scholar) work without keys at lower rate limits.
ACADEMIC_SEARCH=true
SEMANTIC_SCHOLAR_API_KEY=
# Photos fill template photo frames: Openverse (no key) or Pexels when a key is set.
IMAGES_ENABLED=true
PEXELS_API_KEY=
MAX_DECK_IMAGES=4

# ─── Templates ──────────────────────────────────────────
DEFAULT_DOCX_TEMPLATE_PATH=data/sample_templates/Company_Proposal.docx
DEFAULT_PPTX_TEMPLATE_PATH=data/sample_templates/Green Cream Simple Aesthetic Watercolor Presentation.pptx
